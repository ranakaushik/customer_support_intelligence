# Copy to .env and fill in. Never commit .env.

# --- Google Gemini ---  get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used by every LLM step. Kept in config (not code) so we can compare models in the evaluation.
# Pinned (not "-latest") so eval numbers stay comparable. Free tier: ~20 requests per model per day,
# and each message costs 3 requests.
GEMINI_MODEL=gemini-3.5-flash
# Gemini 3 "thinking" effort: minimal | low | medium | high (empty = model default)
GEMINI_THINKING_LEVEL=low
# Leave empty for the model default (Google recommends 1.0 for Gemini 3)
LLM_TEMPERATURE=
# Prompt version per LLM step (files in prompts/)
PROMPT_CLASSIFY=v1
PROMPT_EXTRACT=v1
PROMPT_DRAFT=v1
